	facebook:
		'M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z',
	github:
		'M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z',
};
---

{
	variant === 'rows' ? (
		<ul class="socials" data-reveal-stagger>
			{SOCIAL_LINKS.map((s) => (
				<li>
					<a class="social" href={s.url} target="_blank" rel="me noopener">
						<span class="ico" aria-hidden="true">
							<svg viewBox="0 0 24 24" width="20" height="20">
								<path fill="currentColor" d={icons[s.id]} />
							</svg>
						</span>
						<span class="label">{s.label}</span>
						<span class="handle">{s.handle}</span>
						<span class="sr-only">（新しいタブで開きます）</span>
						<span class="arrow" aria-hidden="true">
							↗
						</span>
					</a>
				</li>
			))}
		</ul>
	) : (
		<ul class="chips">
			{SOCIAL_LINKS.map((s) => (
				<li>
					<a class="chip" href={s.url} target="_blank" rel="me noopener">
						<svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
							<path fill="currentColor" d={icons[s.id]} />
						</svg>
						<span class="chip-label">
							<span>{s.label}</span>
							<span class="chip-handle">{s.handle}</span>
						</span>
						<span class="sr-only">（新しいタブで開きます）</span>
					</a>
				</li>
			))}
		</ul>
	)
}

<style>
	/* ---------- rows ---------- */
	.socials {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.socials > li {
		border-bottom: 1px solid var(--border);
	}
	.social {
		position: relative;
		display: grid;
		grid-template-columns: 2.5rem minmax(0, 1fr) auto 1.5rem;
		align-items: center;
		gap: 1.5rem;
		padding: 1.4rem 0.25rem;
		color: var(--foreground);
		overflow: hidden;
	}
	/* the row tints itself from the left on hover */
	.social::before {
		content: '';
		position: absolute;
		inset: 0;
		background: var(--muted);
		transform: scaleX(0);
		transform-origin: left center;
		transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
		z-index: 0;
	}
	.social:hover::before,
	.social:focus-visible::before {
		transform: scaleX(1);
	}
	.social > * {
		position: relative;
	}
	.social:focus-visible {
		outline: 2px solid var(--ring);
		outline-offset: 2px;
	}
	.ico {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		color: var(--muted-foreground);
		transition:
			color 0.3s ease,
			transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
	}
	.social:hover .ico,
	.social:focus-visible .ico {
		color: var(--primary);
		transform: rotate(-8deg) scale(1.14);
	}
	.label {
		min-width: 0;
		font-size: 1.15rem;
		font-weight: 600;
		letter-spacing: 0.01em;
		transition: color 0.25s ease;
	}
	.social:hover .label {
		color: var(--primary);
	}
	.handle {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		letter-spacing: 0.06em;
		color: var(--muted-foreground);
		transition: color 0.25s ease;
	}
	.social:hover .handle,
	.social:focus-visible .handle {
		color: var(--foreground);
	}
	.arrow {
		justify-self: end;
		color: var(--muted-foreground);
		opacity: 0;
		transform: translate(-0.25em, 0.25em);
		transition:
			opacity 0.3s ease,
			transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
			color 0.3s ease;
	}
	.social:hover .arrow,
	.social:focus-visible .arrow {
		opacity: 1;
		transform: none;
		color: var(--primary);
	}
	@media (max-width: 640px) {
		.social {
			grid-template-columns: 2.25rem minmax(0, 1fr) 1.25rem;
			gap: 0.35rem 1rem;
			padding: 1.15rem 0.25rem;
		}
		.handle {
			grid-column: 2;
			grid-row: 2;
		}
		.arrow {
			grid-column: 3;
			grid-row: 1;
			opacity: 1;
			transform: none;
		}
	}

	/* ---------- chips ---------- */
	.chips {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
	}
	.chip {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.45em 0.95em;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: var(--card);
		color: var(--foreground);
		font-size: 0.87rem;
		line-height: 1.4;
		transition:
			border-color 0.25s ease,
			transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
			color 0.25s ease;
	}
	.chip svg {
		flex-shrink: 0;
		color: var(--muted-foreground);
		transition:
			color 0.25s ease,
			transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
	}
	.chip:hover,
	.chip:focus-visible {
		color: var(--primary);
		border-color: var(--ring);
		transform: translateY(-2px);
	}
	.chip:hover svg,
	.chip:focus-visible svg {
		color: var(--primary);
		transform: rotate(-10deg) scale(1.12);
	}
	.chip-label {
		display: inline-flex;
		align-items: baseline;
		gap: 0.4rem;
	}
	.chip-handle {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		letter-spacing: 0.04em;
		color: var(--muted-foreground);
	}

	@media (prefers-reduced-motion: reduce) {
		.social::before,
		.ico,
		.label,
		.arrow,
		.chip,
		.chip svg {
			transition: none;
		}
		.social:hover .ico,
		.chip:hover,
		.chip:hover svg {
			transform: none;
		}
	}
</style>
