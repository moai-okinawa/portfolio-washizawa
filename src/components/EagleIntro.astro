---
/**
 * Opening for Home: a large eagle (鷲) silhouette sweeps across the viewport
 * and the page is uncovered in its wake. Plays once per tab session and never
 * under `prefers-reduced-motion: reduce`. Without JS nothing is shown.
 *
 * One custom property, --sweep (0 → 1), drives both the eagle's position and
 * the edge of the curtain, so the reveal stays tucked under the wings.
 *
 * Text inside a `[data-eagle-reveal]` container is split into characters, and
 * each one fades in at the moment the wake passes over it (left → right).
 *
 * The sweep waits (behind the curtain) for web fonts, so nothing is revealed in
 * a fallback face and the letters are measured in their final positions.
 */
---

<script is:inline>
	try {
		if (
			!matchMedia('(prefers-reduced-motion: reduce)').matches &&
			!sessionStorage.getItem('eagle-intro')
		) {
			sessionStorage.setItem('eagle-intro', '1');
			const root = document.documentElement;
			root.setAttribute('data-intro', '');
			// failsafe: never leave the curtain up if the script below doesn't run
			setTimeout(() => root.setAttribute('data-intro-go', ''), 2500);
		}
	} catch {}
</script>

<div class="eagle-intro" aria-hidden="true">
	<div class="curtain"></div>
	<svg class="eagle" viewBox="0 0 759 1000" preserveAspectRatio="xMidYMid meet">
		<path
			d="M676 1000 679 1000 679 997 678 996 678 992 676 987 676 984 675 983 675 979 674 978 674 974 673 973 673 969 672 969 672 964 671 963 671 959 670 958 670 954 669 953 669 949 668 948 668 943 667 942 666 933 665 932 665 926 664 925 664 921 664 920 662 901 663 901 664 905 667 914 669 917 669 919 671 922 671 923 675 931 675 933 678 938 678 939 691 965 697 974 709 986 716 990 720 991 721 987 720 986 720 983 719 982 718 975 716 971 715 965 714 964 713 958 711 952 711 949 710 948 709 942 706 936 706 933 704 929 703 923 704 923 708 929 718 939 731 948 736 951 742 952 743 953 745 953 745 951 741 940 741 938 739 936 739 934 736 929 736 927 732 921 732 919 727 910 727 908 721 896 721 894 712 878 712 876 704 859 704 859 710 864 710 865 727 883 728 883 735 890 746 895 756 896 759 894 756 886 754 884 746 870 733 850 730 847 727 841 711 820 711 820 714 821 725 831 737 837 743 838 744 839 751 839 752 838 755 838 756 837 671 753 670 753 664 747 664 746 659 741 658 738 650 727 647 723 643 718 625 699 624 699 618 694 607 685 593 676 578 668 577 666 570 664 568 662 563 660 556 654 498 594 498 594 480 575 480 574 475 568 475 567 464 555 463 553 465 552 467 552 485 542 487 540 498 535 506 528 508 528 511 526 513 526 516 524 519 524 520 523 524 524 526 527 526 518 524 514 519 508 513 504 511 504 508 500 500 492 486 484 484 484 481 482 478 482 474 480 468 479 467 478 463 478 462 477 458 477 457 477 453 477 453 476 449 476 448 475 443 475 442 474 429 472 428 471 422 470 421 469 410 466 405 463 391 449 385 440 384 438 383 436 382 433 380 431 377 424 375 422 358 389 358 387 353 378 353 376 350 370 350 368 341 350 341 348 339 345 339 344 337 341 337 339 336 336 336 334 330 322 329 317 327 314 326 310 324 307 321 297 320 294 320 292 316 282 316 280 312 270 312 267 311 266 311 264 310 263 309 255 308 254 307 250 301 236 299 234 298 232 294 227 293 224 288 216 265 186 259 177 258 174 257 172 244 149 244 147 239 137 239 135 233 125 233 123 218 93 216 91 213 84 211 82 205 70 189 47 186 47 183 51