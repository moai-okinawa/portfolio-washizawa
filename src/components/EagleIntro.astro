		></path>
	</svg>
</div>

<style>
	@property --sweep {
		syntax: '<number>';
		inherits: true;
		initial-value: 0;
	}

	.eagle-intro {
		display: none;
	}
	:global(html[data-intro]) .eagle-intro {
		/* a bit taller than the viewport so the wingtips clip, capped on narrow
		   screens so the whole bird still fits across */
		--h: min(115vh, 140vw);
		--w: calc(var(--h) * 759 / 1000);
		/* start an extra 0.2w off-screen (the tilt swings a wingtip back into view)
		   and travel far enough that the soft edge clears the right side too */
		--x: calc(var(--sweep) * (114vw + var(--w) * 1.2) - var(--w) * 1.2);
		display: block;
		position: fixed;
		inset: 0;
		z-index: 200;
		pointer-events: none;
		overflow: hidden;
		animation: eagle-sweep 1.4s cubic-bezier(0.4, 0.05, 0.3, 1) 0.1s forwards;
		animation-play-state: paused;
	}
	:global(html[data-intro-go]) .eagle-intro {
		animation-play-state: running;
	}

	.curtain {
		position: absolute;
		inset: 0;
		background: var(--background);
		/* soft edge trailing the wings, like a wake */
		--edge: calc(var(--x) + var(--w) * 0.4);
		mask-image: linear-gradient(
			90deg,
			transparent calc(var(--edge) - 14vw),
			#000 var(--edge)
		);
	}

	.eagle {
		position: absolute;
		top: 50%;
		left: 0;
		width: var(--w);
		height: var(--h);
		fill: var(--foreground);
		transform: translate(var(--x), calc(-50% + (0.5 - var(--sweep)) * 18vh)) rotate(-6deg);
	}

	/* Characters created by the script below; each gets its own animation-delay */
	/* stays inline so kerning and Japanese line breaking are untouched */
	:global(.eagle-char) {
		animation: eagle-char-in 0.45s cubic-bezier(0.2, 0.7, 0.2, 1) both;
	}
	@keyframes eagle-char-in {
		from {
			opacity: 0;
			filter: blur(6px);
		}
		to {
			opacity: 1;
			filter: none;
		}
	}
	@keyframes eagle-sweep {
		from {
			--sweep: 0;
		}
		99% {
			visibility: visible;
		}
		to {
			--sweep: 1;
			visibility: hidden;
		}
	}
</style>

<script>
	const intro = document.documentElement.hasAttribute('data-intro')
		? document.querySelector<HTMLElement>('.eagle-intro')
		: null;
	const eagle = intro?.querySelector<SVGElement>('.eagle');
	const sweep = intro?.getAnimations()[0];

	if (intro && eagle && sweep) {
		// fonts first (capped so a slow network doesn't hold the page hostage)
		Promise.race([document.fonts.ready, new Promise((r) => setTimeout(r, 1200))]).then(() => {
			try {
				reveal(eagle, sweep);
			} finally {
				document.documentElement.setAttribute('data-intro-go', '');
			}
		});
	}

	function reveal(eagle: SVGElement, sweep: Animation) {
		const { delay = 0, duration = 0, easing = '' } = sweep.effect?.getComputedTiming() ?? {};
		const [x1, y1, x2, y2] = easing.startsWith('cubic-bezier')
			? (easing.match(/-?[\d.]+/g) ?? []).map(Number)
			: [0, 0, 1, 1];
		const bezier = (a: number, b: number, t: number) =>
			3 * a * (1 - t) ** 2 * t + 3 * b * (1 - t) * t * t + t ** 3;
		// time fraction at which the eased sweep reaches progress p
		const timeAt = (p: number) => {
			let lo = 0;
			let hi = 1;
			for (let i = 0; i < 24; i++) {
				const mid = (lo + hi) / 2;
				if (bezier(y1, y2, mid) < p) lo = mid;
				else hi = mid;
			}
			return bezier(x1, x2, lo);
		};

		// Same geometry as the CSS: x = sweep * (114vw + 1.2w) - 1.2w. A letter starts
		// when the eagle's body (x + 0.5w) is over it, so it emerges from under the wings
		const vw = window.innerWidth / 100;
		const w = parseFloat(getComputedStyle(eagle).width);
		const travel = 114 * vw + 1.2 * w;
		const sweepAt = (cx: number) => Math.min(Math.max((cx + 0.7 * w) / travel, 0), 1);

		const chars: HTMLElement[] = [];
		for (const root of document.querySelectorAll<HTMLElement>('[data-eagle-reveal]')) {
			const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
			const nodes: Text[] = [];
			while (walker.nextNode()) {
				const node = walker.currentNode as Text;
				if (node.data.trim()) nodes.push(node);
			}
			for (const node of nodes) {
				// screen readers get the plain text, the animated letters are decorative
				const label = document.createElement('span');
				label.className = 'sr-only';
				label.textContent = node.data;
				const visual = document.createElement('span');
				visual.setAttribute('aria-hidden', 'true');
				for (const ch of node.data.replace(/\s+/g, ' ')) {
					if (ch === ' ') {
						visual.append(' ');
						continue;
					}
					const span = document.createElement('span');
					span.className = 'eagle-char';
					span.textContent = ch;
					visual.append(span);
					chars.push(span);
				}
				node.replaceWith(label, visual);
			}
			root.setAttribute('data-eagle-split', '');
		}

		const elapsed = Number(sweep.currentTime ?? 0);
		for (const span of chars) {
			const r = span.getBoundingClientRect();
			const at = delay + duration * timeAt(sweepAt(r.left + r.width / 2));
			span.style.animationDelay = `${at - elapsed}ms`;
		}
	}
</script>
