---
import { BLOG_CATEGORIES } from '../consts';

interface Props {
	current?: 'all' | 'tech' | 'travel';
}

const { current = 'all' } = Astro.props;
const items = [
	{ slug: 'all', label: 'All', href: '/blog/' },
	...BLOG_CATEGORIES.map((c) => ({
		slug: c.slug,
		label: c.label,
		href: `/blog/category/${c.slug}/`,
	})),
];
---

<nav class="chips" aria-label="Blog category filter">
	{
		items.map((item) => (
			<a
				href={item.href}
				class:list={['chip', { active: item.slug === current }]}
				aria-current={item.slug === current ? 'page' : undefined}
			>
				{item.label}
			</a>
		))
	}
</nav>

<style>
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 1.75rem;
		margin-bottom: 2.5rem;
	}
	.chip {
		position: relative;
		display: inline-block;
		padding: 0.35em 0;
		color: var(--muted-foreground);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		text-decoration: none;
		transition: color 0.2s ease;
	}
	.chip::after {
		content: '';
		position: absolute;
		left: 0;
		bottom: 0.1em;
		width: 100%;
		height: 1px;
		background: var(--primary);
		transform: scaleX(0);
		transform-origin: right;
		transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.chip:hover,
	.chip:focus-visible {
		color: var(--foreground);
	}
	.chip:hover::after,
	.chip:focus-visible::after {
		transform: scaleX(1);
		transform-origin: left;
	}
	.chip.active {
		color: var(--foreground);
	}
	.chip.active::after {
		transform: scaleX(1);
	}
</style>
