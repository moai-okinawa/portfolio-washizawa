---
import { BLOG_CATEGORIES, type BlogCategory } from '../consts';

interface Props {
	category: BlogCategory;
}

const { category } = Astro.props;
const def = BLOG_CATEGORIES.find((c) => c.slug === category);
const label = def?.label ?? category;
---

<span class:list={['cat-badge', `cat-${category}`]}>{label}</span>

<style>
	.cat-badge {
		display: inline-block;
		padding: 0.18em 0.65em;
		border-radius: 999px;
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.02em;
		line-height: 1.5;
		background: var(--muted);
		color: var(--muted-foreground);
		vertical-align: middle;
	}
	.cat-badge.cat-tech {
		background: color-mix(in oklch, var(--primary) 14%, transparent);
		color: var(--primary);
	}
	.cat-badge.cat-travel {
		background: color-mix(in oklch, var(--accent) 36%, transparent);
		color: var(--foreground);
	}
	.cat-badge.cat-essay {
		background: color-mix(in oklch, var(--ring) 20%, transparent);
		color: var(--foreground);
	}
	.cat-badge.cat-event {
		background: color-mix(in oklch, var(--link-hover) 16%, transparent);
		color: var(--link-hover);
	}
</style>
