---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const education: {
	when: string;
	org: string;
	role: string;
	degree?: string;
	thesis?: string;
	thesisWhen?: string;
}[] = [
	{
		when: '2019.04 – 2020.03',
		org: '学校法人角川ドワンゴ学園 N高等学校',
		role: '中途退学',
	},
	{
		when: '2020.04 – 2025.03',
		org: '国立沖縄工業高等専門学校',
		role: '情報通信システム工学科 卒業',
		degree: '準学士（工学） / Associate Degree in Engineering',
		thesis: '視覚障害者向け支援シューズ 点字ブロック伝達機構の並列動作による時間短縮効果',
		thesisWhen: '2024.04 – 2025.03',
	},
];

const career = [
	{
		when: '2023.10 –',
		org: '個人事業主',
		role: '学生 兼 フリーランスエンジニア',
	},
	{
		when: '2025.04 - 2026.05',
		org: '株式会社FIXER',
		role: '新卒入社。SaaS導入支援 → 新規プロダクト テックリード・エンジニア',
	},
	{
		when: '2026.06 –',
		org: '株式会社CODEVISION',
		role: 'COO & CAIO',
	},
];

const achievements: {
	when: string;
	title: string;
	theme?: string;
	award?: string;
}[] = [
	{
		when: '2026.09',
		title: 'GUINNESS WORLD RECORDS™',
		theme: 'Largest sign singing lesson online and in a single venue simultaneously',
		award: 'Record Participant',
	},
	{
		when: '2024.06 – 2025.02',
		title: 'WiCON2024',
		theme: '視覚障がい者の自由な移動を支援する次世代ウエアラブルデバイス「わんだらん」',
		award: 'WiCONイノベーション賞',
	},
	{
		when: '2024.09',
		title: '第1回 高専キャリア起業部ピッチ',
		theme: 'Syuwable すべての手話ユーザーのコミュ力爆上げ！',
		award: '起業部賞',
	},
	{
		when: '2023.10 – 2024.01',
		title: 'WiCON2023',
		theme: '沖縄北部の固有鳥ヤンバルクイナのロードキル防止と確かな保護観察 クイナート',
		award: 'ミライト・ワン賞',
	},
	{
		when: '2023.04 – 2023.10',
		title: 'アイデア対決・全国高等専門学校ロボットコンテスト2023 九州・沖縄地区大会',
		theme: 'もぎもぎ！フルーツGOラウンド',
		award: '-',
	},
	{
		when: '2022.04 – 2022.10',
		title: 'アイデア対決・全国高等専門学校ロボットコンテスト2022 九州・沖縄地区大会',
		theme: 'ミラクル☆フライ 〜空へ舞いあがれ！〜',
		award: '特別賞（東京エレクトロン株式会社）',
	},
	{
		when: '2021.08 – 2021.11',
		title: 'テクノアイデアコンテスト「テクノ愛」2021 高校の部',
		theme: '聴覚・言語障がい者向け次世代コミュニケーションメガネ',
		award: '奨励賞',
	},
	{
		when: '2021.03',
		title: '令和2年度 社会実装教育フォーラム',
		theme: '聴覚・言語障がい者向けコミュニケーションシステム',
		award: '社会実装構想賞 / 社会実装賞',
	},
	{
		when: '2020.04 – 2020.08',
		title: 'U18 IT夢コンテスト2020',
		theme: '失語症患者や聾者・聾重複者向けAIコミュニケーションシステム',
		award: '優秀賞（私立中学高等学校協会理事長賞）',
	},
];

const skills = [
	{
		category: 'Spoken Languages',
		items: ['Japanese (Native)', 'English (Business level)', 'Korean (Basic)'],
	},
	{
		category: 'Languages',
		items: ['TypeScript', 'Python', 'Dart', 'C#', 'C++'],
	},
	{
		category: 'Frameworks / Libraries',
		items: ['Next.js', 'React', 'Astro', 'Flutter', 'ASP.NET Core', 'Tailwind CSS'],
	},
	{
		category: 'Infrastructure',
		items: ['Cloudflare', 'Vercel', 'Docker', 'AWS', 'Azure', 'Postgres', 'Supabase'],
	},
	{
		category: 'Tools',
		items: ['Figma', 'GitHub Actions', 'Claude Code', 'Codex'],
	},
];

const licenses: {
	name: string;
	issuer: string;
	credentialId?: string;
	url?: string;
}[] = [
	{
		name: 'Certificate of completion: Introduction to Claude Cowork',
		issuer: 'Anthropic',
		credentialId: 'qyn3jt4kehqz',
		url: 'https://verify.skilljar.com/c/qyn3jt4kehqz',
	},
	{
		name: 'Certificate of Completion: AI Fluency Framework & Foundations',
		issuer: 'Anthropic',
		credentialId: 'bsthebufvgnn',
		url: 'https://verify.skilljar.com/c/bsthebufvgnn',
	},
	{
		name: 'Certificate of completion: Claude 101',
		issuer: 'Anthropic',
		credentialId: 'x2p6oi86maja',
		url: 'https://verify.skilljar.com/c/x2p6oi86maja',
	},
	{
		name: 'ポニーライダー技能認定（ライセンス）5級',
		issuer: '公益社団法人 全国乗馬倶楽部振興協会',
	},
	{
		name: 'ヤマハ音楽能力検定制度（ヤマハグレード）ピアノ演奏グレードBコース6級',
		issuer: '一般財団法人 ヤマハ音楽振興会',
	},
];

const PREVIEW_COUNT = 3;
const achievementsPreview = achievements.slice(0, PREVIEW_COUNT);
const achievementsRest = achievements.slice(PREVIEW_COUNT);
const licensesPreview = licenses.slice(0, PREVIEW_COUNT);
const licensesRest = licenses.slice(PREVIEW_COUNT);
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`About — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main id="main-content">
			<header class="page-head">
				<p class="eyebrow rise-in" style="--delay: 0.05s">Profile</p>
				<h1 class="display">
					<span class="mask-line"
						><span style="--delay: 0.18s">About</span></span
					>
				</h1>
			</header>

			<section data-reveal>
				<h2><span class="sec-num">01</span>Profile</h2>
				<div class="profile-grid">
					<img class="avatar" src="/profile.jpg" alt="プロフィール写真" width="96" height="96" />
					<dl class="info">
						<dt>名前</dt>
						<dd>鷲澤 稜河 <span class="muted">(Ryoga Washizawa)</span></dd>
						<dt>ニックネーム</dt>
						<dd>わっしー / Wassy</dd>
						<dt>出身</dt>
						<dd>2004年生・群馬県</dd>
						<dt>MBTI</dt>
						<dd>ENTJ-A <span class="muted">(指揮官 / Commander)</span></dd>
					</dl>
				</div>
				<div class="bio">
					<p>
						2004年、群馬県生まれのエンジニアです。沖縄高専で情報工学を学び、在学中にフリーランスエンジニアとして開発の現場に飛び込みました。新卒で入社した株式会社FIXERでは、自治体関連機関に週数日のみ常駐する形でのSaaS導入支援と、新規プロダクトのテックリードを経験し、現在は株式会社CODEVISIONのCOO
						&amp; CAIOとして、経営とAI活用の両面からプロダクトづくりに取り組んでいます。
					</p>
					<p>
						モットーは「速さは習慣、学びは現場で」。フロントエンドからインフラまで領域を区切らず、新しい技術はまず手を動かして試すスタイルです。高専在学中には手話翻訳システムの開発を行うなど、障がい者福祉の分野をはじめ、技術で誰かの壁を取り除くことに強い関心があります。
					</p>
					<p>
						プライベートでは打って変わって、旅と映画と読書の人です。思い立ったらそのままの勢いで海外へ足を運ぶくらい旅行が好きで、旅先で新しい言語を拾ってくるのも楽しみのひとつ。時間と健康を何より大切にしながら、エンジニアの腕を育て続けています。
					</p>
				</div>
			</section>

			<section data-reveal>
				<h2><span class="sec-num">02</span>Education</h2>
				<ol class="timeline" data-reveal-stagger>
					{
						education.map((e) => (
							<li>
								<span class="when">{e.when}</span>
								<div class="entry">
									<h3>{e.org}</h3>
									<p class="role">{e.role}</p>
									{e.degree && <p class="degree">{e.degree}</p>}
									{e.thesis && (
										<p class="thesis">
											<span class="thesis-label">卒業研究</span>「{e.thesis}」
											{e.thesisWhen && <span class="thesis-when">{e.thesisWhen}</span>}
										</p>
									)}
								</div>
							</li>
						))
					}
				</ol>
			</section>

			<section data-reveal>
				<h2><span class="sec-num">03</span>Career</h2>
				<ol class="timeline" data-reveal-stagger>
					{
						career.map((c) => (
							<li>
								<span class="when">{c.when}</span>
								<div class="entry">
									<h3>{c.org}</h3>
									<p class="role">{c.role}</p>
								</div>
							</li>
						))
					}
				</ol>
			</section>

			<section data-reveal>
				<h2><span class="sec-num">04</span>Achievements</h2>
				<ul class="achievements" data-reveal-stagger>
					{
						achievementsPreview.map((a) => (
							<li class="achievement">
								<span class="when">{a.when}</span>
								<div class="entry">
									<h3>{a.title}</h3>
									{a.theme && <p class="theme">{a.theme}</p>}
									{a.award && <p class="award">{a.award}</p>}
								</div>
							</li>
						))
					}
				</ul>
				{
					achievementsRest.length > 0 && (
						<details class="more">
							<summary>
								<span class="more-label more-label-open">View all (+{achievementsRest.length})</span>
								<span class="more-label more-label-close">Show less</span>
								<svg class="chev" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="m6 9 6 6 6-6" />
								</svg>
							</summary>
							<ul class="achievements more-list">
								{achievementsRest.map((a) => (
									<li class="achievement">
										<span class="when">{a.when}</span>
										<div class="entry">
											<h3>{a.title}</h3>
											{a.theme && <p class="theme">{a.theme}</p>}
											{a.award && <p class="award">{a.award}</p>}
										</div>
									</li>
								))}
							</ul>
						</details>
					)
				}
			</section>

			<section data-reveal>
				<h2><span class="sec-num">05</span>Skills</h2>
				<div class="skills" data-reveal-stagger>
					{
						skills.map((group) => (
							<div class="skill-group">
								<p class="skill-cat">{group.category}</p>
								<div class="skill-tags">
									{group.items.map((item) => (
										<span class="skill-tag">{item}</span>
									))}
								</div>
							</div>
						))
					}
				</div>
			</section>

			{/* Licenses & certifications：一時非表示（復活時はこのコメントを外し、Contact の sec-num を 07 に戻す）
			<section data-reveal>
				<h2><span class="sec-num">06</span>Licenses &amp; certifications</h2>
				<ul class="licenses" data-reveal-stagger>
					{
						licensesPreview.map((l) => (
							<li class="license">
								<div class="license-body">
									<h3 class="license-name">{l.name}</h3>
									<p class="license-issuer">{l.issuer}</p>
									{l.credentialId && <p class="license-meta">Credential ID {l.credentialId}</p>}
									{l.url && (
										<a class="license-link" href={l.url} target="_blank" rel="noopener">
											Show credential
											<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
												<path d="M7 17 17 7" />
												<path d="M8 7h9v9" />
											</svg>
										</a>
									)}
								</div>
							</li>
						))
					}
				</ul>
				{
					licensesRest.length > 0 && (
						<details class="more">
							<summary>
								<span class="more-label more-label-open">View all (+{licensesRest.length})</span>
								<span class="more-label more-label-close">Show less</span>
								<svg class="chev" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="m6 9 6 6 6-6" />
								</svg>
							</summary>
							<ul class="licenses more-list">
								{licensesRest.map((l) => (
									<li class="license">
										<div class="license-body">
											<h3 class="license-name">{l.name}</h3>
											<p class="license-issuer">{l.issuer}</p>
											{l.credentialId && <p class="license-meta">Credential ID {l.credentialId}</p>}
											{l.url && (
												<a class="license-link" href={l.url} target="_blank" rel="noopener">
													Show credential
													<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
														<path d="M7 17 17 7" />
														<path d="M8 7h9v9" />
													</svg>
												</a>
											)}
										</div>
									</li>
								))}
							</ul>
						</details>
					)
				}
			</section>
			*/}

			<section data-reveal>
				<h2><span class="sec-num">06</span>Contact</h2>
				<SocialLinks variant="chips" />
				<a class="link-more contact-link" href="/contact">
					<span class="label">Contact &amp; SNS</span> <span class="arrow">→</span>
				</a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: var(--container);
		max-width: calc(100% - 2.5em);
		margin: 0 auto;
		padding: 0 0 6rem;
	}
	.page-head .display {
		margin-top: 1.25rem;
	}
	section {
		margin-bottom: 4.5rem;
	}
	h2 {
		display: flex;
		align-items: baseline;
		gap: 1rem;
		font-size: 0.95rem;
		font-weight: 600;
		letter-spacing: 0.24em;
		text-transform: uppercase;
		margin: 0 0 1.75rem;
		padding-bottom: 0.75rem;
		border-bottom: 1px solid var(--border);
	}
	.sec-num {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		font-weight: 500;
		color: var(--primary);
		letter-spacing: 0.1em;
	}

	/* Profile */
	.profile-grid {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 1.5rem;
		align-items: start;
	}
	.avatar {
		width: 96px;
		height: 96px;
		border-radius: 50%;
		object-fit: cover;
		background: var(--muted);
		border: 1px solid var(--border);
		flex-shrink: 0;
	}
	.info {
		display: grid;
		grid-template-columns: max-content 1fr;
		column-gap: 1.5rem;
		row-gap: 0.5rem;
		margin: 0;
	}
	.info dt {
		color: var(--muted-foreground);
		font-weight: 600;
		font-size: 0.85rem;
		padding-top: 0.1rem;
	}
	.info dd {
		margin: 0;
	}
	.muted {
		color: var(--muted-foreground);
		font-size: 0.95em;
	}
	.bio {
		margin-top: 2rem;
	}
	.bio p {
		margin: 0 0 1.4em;
		line-height: 2;
		font-size: 0.97rem;
		text-align: justify;
	}
	.bio p:last-child {
		margin-bottom: 0;
	}

	/* Timeline */
	.timeline {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.timeline > li {
		position: relative;
		display: grid;
		grid-template-columns: 6.5rem 1fr;
		gap: 1.25rem;
		padding: 0 0 1.4rem 1.25rem;
		border-left: 1px solid var(--border);
		margin-left: 0.25rem;
	}
	.timeline > li:last-child {
		padding-bottom: 0;
		border-left-color: transparent;
	}
	.timeline > li::before {
		content: '';
		position: absolute;
		left: -5px;
		top: 0.45rem;
		width: 9px;
		height: 9px;
		border-radius: 999px;
		background: var(--primary);
		border: 2px solid var(--background);
		box-shadow: 0 0 0 1px var(--border);
	}
	.when {
		font-variant-numeric: tabular-nums;
		font-size: 0.85rem;
		color: var(--muted-foreground);
		padding-top: 0.15rem;
		letter-spacing: 0.01em;
	}
	.entry h3 {
		margin: 0;
		font-size: 1rem;
		font-weight: 600;
		letter-spacing: 0;
	}
	.role {
		margin: 0.2rem 0 0;
		color: var(--muted-foreground);
		font-size: 0.92rem;
		line-height: 1.55;
	}

	/* Achievements */
	.achievements {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.achievement {
		display: grid;
		grid-template-columns: 6.5rem 1fr;
		gap: 1.25rem;
		padding: 1.1rem 0;
		border-top: 1px solid var(--border);
	}
	.achievement:first-child {
		border-top: none;
		padding-top: 0;
	}
	.achievement:last-child {
		padding-bottom: 0;
	}
	.achievement .entry h3 {
		line-height: 1.5;
	}
	.theme {
		margin: 0.3rem 0 0;
		font-size: 0.92rem;
		line-height: 1.6;
		color: var(--muted-foreground);
	}
	.award,
	.degree {
		margin: 0.3rem 0 0;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--primary);
		letter-spacing: 0.01em;
	}
	.thesis {
		margin: 0.5rem 0 0;
		font-size: 0.88rem;
		line-height: 1.65;
		color: var(--muted-foreground);
	}
	.thesis-label {
		display: inline-block;
		margin-right: 0.4rem;
		padding: 0.1em 0.5em;
		border: 1px solid var(--border);
		border-radius: 999px;
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.02em;
	}
	.thesis-when {
		display: block;
		margin-top: 0.2rem;
		font-variant-numeric: tabular-nums;
		font-size: 0.8rem;
	}

	/* Skills */
	.skills {
		display: grid;
		gap: 1.25rem;
	}
	.skill-group {
		display: grid;
		grid-template-columns: 9rem 1fr;
		gap: 1rem;
		align-items: start;
	}
	.skill-cat {
		margin: 0.35rem 0 0;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--muted-foreground);
		letter-spacing: 0.01em;
	}
	.skill-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.skill-tag {
		display: inline-block;
		padding: 0.3em 0.75em;
		border: 1px solid var(--border);
		background: var(--card);
		border-radius: calc(var(--radius) - 0.1rem);
		font-size: 0.85rem;
		color: var(--foreground);
	}

	/* Licenses & certifications */
	.licenses {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 0;
	}
	.license {
		padding: 1.1rem 0;
		border-top: 1px solid var(--border);
	}
	.license:first-child {
		border-top: none;
		padding-top: 0;
	}
	.license:last-child {
		padding-bottom: 0;
	}
	.license-body {
		min-width: 0;
	}
	.license-name {
		margin: 0;
		font-size: 1rem;
		font-weight: 600;
		line-height: 1.4;
	}
	.license-issuer {
		margin: 0.15rem 0 0;
		font-size: 0.92rem;
	}
