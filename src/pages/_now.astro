---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const lastUpdated = '2026-05-24';
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`Now — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<header class="page-head">
				<h1>Now</h1>
			</header>

			<p class="lead">
				いま取り組んでいること・触れているもの・行きたいところ。数週間ごとに更新します。
			</p>
			<p class="updated">最終更新：{lastUpdated}</p>

			<section>
				<h2>仕事</h2>
				<ul>
					<li>株式会社FIXERで新規プロダクトのテックリード・エンジニアとして開発</li>
				</ul>
			</section>

			<section>
				<h2>個人で取り組んでいるもの</h2>
				<ul>
					<li>このポートフォリオ（wassy328.com）の整備</li>
				</ul>
			</section>

			<section>
				<h2>学んでいるもの</h2>
				<ul>
					<li>韓国語（先日のソウル旅行をきっかけに本腰）</li>
				</ul>
			</section>

			<section>
				<h2>読んでいるもの</h2>
				<ul>
					<li>東野圭吾 マスカレードシリーズを再読中</li>
				</ul>
			</section>

			<section>
				<h2>行きたいところ</h2>
				<ul>
					<li>観光客の少ない韓国エリア（語学の実戦のため）</li>
					<li>日本国内の自然と文化に触れたい</li>
					<li>スリランカ</li>
				</ul>
			</section>

			<p class="footnote">
				このページは <a href="https://nownownow.com/about" target="_blank" rel="noopener">/now movement</a> に倣ったものです。
			</p>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-head {
		padding: 0;
		margin-bottom: 1.5rem;
	}
	.page-head h1 {
		margin: 0;
	}
	.lead {
		margin: 0 0 0.5rem;
		color: var(--foreground);
	}
	.updated {
		margin: 0 0 2rem;
		font-size: 0.85rem;
		color: var(--muted-foreground);
		font-variant-numeric: tabular-nums;
	}
	section {
		margin-bottom: 1.75rem;
	}
	h2 {
		font-size: 1.1rem;
		margin: 0 0 0.75rem;
	}
	ul {
		margin: 0;
		padding-left: 1.25rem;
	}
	li {
		margin-bottom: 0.4rem;
		color: var(--foreground);
	}
	li:last-child {
		margin-bottom: 0;
	}
	.footnote {
		margin: 2.5rem 0 0;
		padding-top: 1rem;
		border-top: 1px solid var(--border);
		color: var(--muted-foreground);
		font-size: 0.875rem;
	}
</style>
