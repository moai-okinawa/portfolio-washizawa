---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import BlogCategoryChips from '../../../components/BlogCategoryChips.astro';
import CategoryBadge from '../../../components/CategoryBadge.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { BLOG_CATEGORIES, SITE_DESCRIPTION, SITE_TITLE } from '../../../consts';

export async function getStaticPaths() {
	return BLOG_CATEGORIES.map((c) => ({
		params: { category: c.slug },
		props: { categoryDef: c },
	}));
}

const { categoryDef } = Astro.props;
const allPosts = await getCollection('blog');
const posts = allPosts
	.filter((p) => p.data.category === categoryDef.slug)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const pageTitle = `${categoryDef.label} — Blog — ${SITE_TITLE}`;
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={pageTitle} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main id="main-content">
			<header class="page-head">
				<p class="eyebrow rise-in" style="--delay: 0.05s">Writing</p>
				<h1 class="display">
					<span class="mask-line"
						><span style="--delay: 0.18s">{categoryDef.label}</span></span
					>
				</h1>
			</header>

			<BlogCategoryChips current={categoryDef.slug} />

			{
				posts.length === 0 ? (
					<div class="empty" data-reveal>
						<p class="empty-mark" aria-hidden="true">
							--
						</p>
						<p>{categoryDef.label} の記事はまだありません。</p>
					</div>
				) : (
					<ol class="index-list">
						{posts.map((post, i) => (
							<li data-reveal style={`--reveal-delay: ${i * 0.06}s`}>
								<a class="row" href={`/blog/${post.id}/`}>
									<span class="num">{String(i + 1).padStart(2, '0')}</span>
									<span class="row-body">
										<span class="row-title">{post.data.title}</span>
										<span class="row-desc">{post.data.description}</span>
									</span>
									<span class="row-meta">
										<CategoryBadge category={post.data.category} />
										<span class="date">
											<FormattedDate date={post.data.pubDate} />
										</span>
									</span>
									<span class="row-arrow" aria-hidden="true">
										→
									</span>
								</a>
							</li>
						))}
					</ol>
				)
			}
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: var(--container-wide);
		max-width: calc(100% - 2.5em);
		margin: 0 auto;
		padding: 0 0 6rem;
	}
	.page-head .display {
		margin-top: 1.25rem;
	}

	.empty {
		padding: 5rem 1.25rem;
		border-top: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
		text-align: center;
		color: var(--muted-foreground);
	}
	.empty p {
		margin: 0;
	}
	.empty-mark {
		font-family: var(--font-mono);
		letter-spacing: 0.3em;
		color: var(--primary);
		margin-bottom: 0.75rem;
	}

	.index-list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--border);
	}
	.index-list li {
		border-bottom: 1px solid var(--border);
	}
	.row {
		display: grid;
		grid-template-columns: 3.5rem 1fr auto 2rem;
		align-items: center;
		gap: 1.5rem;
		padding: 1.75rem 0.25rem;
		color: var(--foreground);
		transition: padding 0.3s ease;
	}
	.row:hover {
		color: var(--foreground);
		padding-left: 0.75rem;
	}
	.num {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--primary);
		letter-spacing: 0.1em;
	}
	.row-body {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		min-width: 0;
	}
	.row-title {
		font-size: clamp(1.15rem, 2.2vw, 1.5rem);
		font-weight: 600;
		line-height: 1.3;
		transition: color 0.2s ease;
	}
	.row:hover .row-title,
	.row:focus-visible .row-title {
		color: var(--primary);
	}
	.row-desc {
		font-size: 0.9rem;
		color: var(--muted-foreground);
		line-height: 1.6;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.row-meta {
		display: flex;
		align-items: center;
		gap: 1rem;
		flex-shrink: 0;
	}
	.date {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.12em;
		color: var(--muted-foreground);
		font-variant-numeric: tabular-nums;
	}
	.row-arrow {
		justify-self: end;
		color: var(--muted-foreground);
		transform: translateX(-0.3em);
		opacity: 0;
		transition:
			transform 0.25s ease,
			opacity 0.25s ease,
			color 0.25s ease;
	}
	.row:hover .row-arrow,
	.row:focus-visible .row-arrow {
		transform: translateX(0);
		opacity: 1;
		color: var(--primary);
	}

	@media (max-width: 720px) {
		.row {
			grid-template-columns: 2.5rem 1fr;
			gap: 0.75rem 1rem;
			padding: 1.4rem 0.25rem;
		}
		.row-meta {
			grid-column: 2;
			flex-wrap: wrap;
			gap: 0.75rem;
		}
		.row-arrow {
			display: none;
		}
	}
</style>
