---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { CONTACT_EMAIL, CONTACT_FORM_URL, SITE_TITLE } from '../consts';

const DESCRIPTION = 'SNS アカウントとお問い合わせ先。お仕事のご相談・ご質問はこちらから。';

// Email セクションは CONTACT_EMAIL 設定時のみ描画されるため、セクション番号をずらす
const formSecNum = CONTACT_EMAIL ? '03' : '02';

---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`Contact — ${SITE_TITLE}`} description={DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main id="main-content">
			<header class="page-head">
				<p class="eyebrow rise-in" style="--delay: 0.05s">Get in touch</p>
				<h1 class="display">
					<span class="mask-line"><span style="--delay: 0.18s">Contact</span></span>
				</h1>
				<p class="lead rise-in" style="--delay: 0.42s">
					お仕事のご相談、登壇・執筆のご依頼、あるいは雑談でも。
				</p>
			</header>

			<section data-reveal>
				<h2><span class="sec-num">01</span>Social</h2>
				<SocialLinks variant="rows" />
			</section>

			{
				CONTACT_EMAIL && (
					<section data-reveal>
						<h2>
							<span class="sec-num">02</span>Email
						</h2>
						<div class="form-block">
							<p class="form-copy">メールでのご連絡はこちらへ。内容を確認のうえご返信します。</p>
							<a class="form-cta" href={`mailto:${CONTACT_EMAIL}`}>
								<span class="label">{CONTACT_EMAIL}</span>
								<span class="arrow">→</span>
							</a>
						</div>
					</section>
				)
			}

			<section data-reveal>
				<h2><span class="sec-num">{formSecNum}</span>Contact form</h2>
				{
					CONTACT_FORM_URL ? (
						<div class="form-block">
							<p class="form-copy">
								フォームからのお問い合わせはこちら。内容を確認のうえ、数日以内にご返信します。
							</p>
							<a class="form-cta" href={CONTACT_FORM_URL} target="_blank" rel="noopener">
								<span class="label">Open the form</span>
								<span class="arrow">↗</span>
								<span class="sr-only">（新しいタブで開きます）</span>
							</a>
						</div>
					) : (
						<div class="form-block soon">
							<p class="status">
								<span class="pulse" aria-hidden="true" />
								Coming soon
							</p>
							<p class="form-copy">
								お問い合わせフォーム（Google
								Forms）は現在準備中です。公開までは、上記のSNSアカウント宛のDMをご利用ください。お仕事のご相談は
								X または GitHub 経由のご連絡が確実です。
							</p>
							<span class="form-cta is-disabled" aria-disabled="true">
								<span class="label">Form in preparation</span>
								<span class="arrow">↗</span>
							</span>
						</div>
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: var(--container);
		max-width: calc(100% - 2.5em);
		margin: 0 auto;
		padding: 0 0 6rem;
	}
	.page-head {
		padding-bottom: 4rem;
	}
	.page-head .display {
		margin-top: 1.25rem;
	}
	.lead {
		margin: 1.75rem 0 0;
		max-width: 34em;
		color: var(--muted-foreground);
		font-size: 0.97rem;
		line-height: 2;
	}
	section {
		margin-bottom: 4.5rem;
	}
	h2 {
		display: flex;
		align-items: baseline;
		gap: 1rem;
		font-size: 0.95rem;
		font-weight: 600;
		letter-spacing: 0.24em;
		text-transform: uppercase;
		margin: 0 0 1.75rem;
		padding-bottom: 0.75rem;
		border-bottom: 1px solid var(--border);
	}
	.sec-num {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		font-weight: 500;
		color: var(--primary);
		letter-spacing: 0.1em;
	}

	/* Contact form block */
	.form-block {
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--card);
		padding: 1.75rem;
	}
	.status {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0 0 0.9rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.24em;
		text-transform: uppercase;
		color: var(--primary);
	}
	.pulse {
		position: relative;
		width: 8px;
		height: 8px;
		border-radius: 999px;
		background: var(--primary);
		flex-shrink: 0;
	}
	.pulse::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background: var(--primary);
		animation: pulse 2s cubic-bezier(0.22, 1, 0.36, 1) infinite;
	}
	@keyframes pulse {
		0% {
			transform: scale(1);
			opacity: 0.6;
		}
		70%,
		100% {
			transform: scale(3);
			opacity: 0;
		}
	}
	.form-copy {
		margin: 0 0 1.4rem;
		font-size: 0.95rem;
		line-height: 1.95;
		color: var(--muted-foreground);
	}
	.form-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.6em 1.3em;
		border: 1px solid var(--border);
		border-radius: 999px;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--foreground);
		transition:
			background 0.25s ease,
			border-color 0.25s ease,
			color 0.25s ease;
	}
	.form-cta:not(.is-disabled):hover,
	.form-cta:not(.is-disabled):focus-visible {
		background: var(--primary);
		border-color: var(--primary);
		color: var(--primary-foreground);
	}
	.form-cta .arrow {
		display: inline-block;
		transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.form-cta:not(.is-disabled):hover .arrow {
		transform: translate(0.2em, -0.2em);
	}
	.form-cta.is-disabled {
		color: var(--muted-foreground);
		border-style: dashed;
		cursor: not-allowed;
	}

	@media (prefers-reduced-motion: reduce) {
		.pulse::after {
			animation: none;
		}
		.form-cta,
		.form-cta .arrow {
			transition: none;
		}
	}

	@media (max-width: 560px) {
		.form-block {
			padding: 1.4rem;
		}
	}
</style>
