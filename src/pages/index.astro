---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import CategoryBadge from '../components/CategoryBadge.astro';
import EagleIntro from '../components/EagleIntro.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const projects = (await getCollection('projects'))
	.sort((a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf())
	.slice(0, 3);

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<EagleIntro />
		<Header />
		<main id="main-content">
			<section class="hero">
				<div class="hero-inner" data-eagle-reveal>
					<p class="eyebrow">Engineer &amp; Traveler</p>
					<h1 class="hero-title">
						<span class="line">Ryoga</span>
						<span class="line">Washizawa<span class="period">.</span></span>
					</h1>
					<p class="tagline">
						速さは習慣、学びは現場で。<br />
						新しい技術と現場に飛び込みながら、エンジニアの腕を育て続けています。
					</p>
					<div class="cta">
						<a class="link-more" href="/projects"
							><span class="label">View Projects</span> <span class="arrow">→</span></a
						>
						<a class="link-more sub" href="/about"
							><span class="label">About</span> <span class="arrow">→</span></a
						>
					</div>
				</div>
				<div class="scroll-hint" aria-hidden="true">
					<span class="scroll-text">Scroll</span>
					<span class="scroll-line"></span>
				</div>
			</section>

			<section class="block" data-reveal>
				<div class="block-head">
					<h2 class="eyebrow"><span class="index">01</span> Projects</h2>
					<a class="link-more" href="/projects"><span class="label">View more</span> <span class="arrow">→</span></a>
				</div>
				<ol class="index-list" data-reveal-stagger>
					{
						projects.map((project, i) => (
							<li>
								<a class="row" href={`/projects/${project.id}/`}>
									<span class="num">{String(i + 1).padStart(2, '0')}</span>
									<span class="row-body">
										<span class="row-title">{project.data.title}</span>
										<span class="row-desc">{project.data.description}</span>
									</span>
									<span class="row-meta">
										<span class="year">{project.data.startDate.getFullYear()}</span>
										<span class="kind">{project.data.status}</span>
									</span>
									<span class="row-arrow" aria-hidden="true">→</span>
								</a>
							</li>
						))
					}
				</ol>
			</section>

			{
				posts.length > 0 && (
					<section class="block" data-reveal>
						<div class="block-head">
							<h2 class="eyebrow">
								<span class="index">02</span> Blog
							</h2>
							<a class="link-more" href="/blog">
								<span class="label">View more</span> <span class="arrow">→</span>
							</a>
						</div>
						<ol class="index-list" data-reveal-stagger>
							{posts.map((post, i) => (
								<li>
									<a class="row" href={`/blog/${post.id}/`}>
										<span class="num">{String(i + 1).padStart(2, '0')}</span>
										<span class="row-body">
											<span class="row-title">{post.data.title}</span>
										</span>
										<span class="row-meta">
											<CategoryBadge category={post.data.category} />
											<span class="year">
												<FormattedDate date={post.data.pubDate} />
											</span>
										</span>
										<span class="row-arrow" aria-hidden="true">→</span>
									</a>
								</li>
							))}
						</ol>
					</section>
				)
			}
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: var(--container-wide);
		max-width: calc(100% - 2.5em);
		margin: 0 auto;
		padding: 0 0 6rem;
	}

	/* Hero */
	.hero {
		position: relative;
		display: flex;
		align-items: center;
		min-height: calc(100svh - 72px);
		padding: 4rem 0 5rem;
	}
	.hero-inner {
		/* Flex items won't shrink below their min-content width by default. iOS Safari
		   measures that while Noto Sans JP is still loading (the tagline counts as one
		   unbreakable line) and never re-measures, so the hero overflowed the screen */
		min-width: 0;
		max-width: 52rem;
		padding-left: 4.5rem;
	}
	@media (max-width: 720px) {
		.hero-inner {
			padding-left: 0;
		}
	}
	.hero .eyebrow {
		margin-bottom: 2rem;
	}
	.hero-title {
		margin: 0 0 2.25rem;
		font-size: clamp(2.5rem, 8.2vw, 7rem);
		font-weight: 700;
		line-height: 0.98;
		letter-spacing: 0.01em;
		text-transform: uppercase;
	}
	.hero-title .line {
		display: block;
	}
	.hero-title .period {
		color: var(--primary);
	}
	.tagline {
		margin: 0 0 3rem;
		max-width: 38em;
		font-size: 1.05rem;
		color: var(--muted-foreground);
		line-height: 2;
	}
	.cta {
		display: flex;
		flex-wrap: wrap;
		gap: 2.5rem;
	}
	.link-more.sub {
		color: var(--muted-foreground);
	}
	.link-more.sub:hover {
		color: var(--primary);
	}

	.scroll-hint {
		position: absolute;
		bottom: 0;
		left: 0.15rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
	}
	.scroll-text {
		writing-mode: vertical-rl;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.32em;
		text-transform: uppercase;
		color: var(--muted-foreground);
	}
	.scroll-line {
		width: 1px;
		height: 4rem;
		background: var(--border);
		position: relative;
		overflow: hidden;
	}
	.scroll-line::after {
		content: '';
		position: absolute;
		top: -100%;
		left: 0;
		width: 100%;
		height: 100%;
		background: var(--primary);
		animation: scroll-drop 2.2s cubic-bezier(0.65, 0, 0.35, 1) infinite;
	}
	@keyframes scroll-drop {
		0% {
			top: -100%;
		}
		55% {
			top: 0;
		}
		100% {
			top: 100%;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.scroll-line::after {
			animation: none;
		}
	}

	/* Blocks */
	.block {
		padding: 5rem 0 0;
	}
	.block-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 2.5rem;
	}

	/* Numbered editorial list */
	.index-list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--border);
	}
	.index-list li {
		border-bottom: 1px solid var(--border);
	}
	.row {
		display: grid;
		grid-template-columns: 3.5rem 1fr auto 2rem;
		align-items: center;
		gap: 1.5rem;
		padding: 1.75rem 0.25rem;
		color: var(--foreground);
		transition: padding 0.3s ease;
	}
	.row:hover {
		color: var(--foreground);
		padding-left: 0.75rem;
	}
	.num {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--primary);
		letter-spacing: 0.1em;
	}
	.row-body {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		min-width: 0;
	}
	.row-title {
		font-size: clamp(1.15rem, 2.2vw, 1.5rem);
		font-weight: 600;
		line-height: 1.3;
		letter-spacing: 0.01em;
		transition: color 0.2s ease;
	}
	.row:hover .row-title,
	.row:focus-visible .row-title {
		color: var(--primary);
	}
	.row-desc {
		font-size: 0.9rem;
		color: var(--muted-foreground);
		line-height: 1.6;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.row-meta {
		display: flex;
		align-items: center;
		gap: 1rem;
		flex-shrink: 0;
	}
	.year {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.12em;
		color: var(--muted-foreground);
		font-variant-numeric: tabular-nums;
	}
	.kind {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--primary);
	}
	.row-arrow {
		justify-self: end;
		color: var(--muted-foreground);
		transform: translateX(-0.3em);
		opacity: 0;
		transition:
			transform 0.25s ease,
			opacity 0.25s ease,
			color 0.25s ease;
	}
	.row:hover .row-arrow,
	.row:focus-visible .row-arrow {
		transform: translateX(0);
		opacity: 1;
		color: var(--primary);
	}

	@media (max-width: 720px) {
		.hero {
			min-height: calc(100svh - 64px);
			padding-bottom: 6rem;
		}
		.tagline {
			font-size: 0.95rem;
		}
		.cta {
			gap: 1.75rem;
		}
		.block {
			padding-top: 3.5rem;
		}
		.row {
			grid-template-columns: 2.5rem 1fr;
			gap: 0.75rem 1rem;
			padding: 1.4rem 0.25rem;
		}
		.row-meta {
			grid-column: 2;
			flex-wrap: wrap;
			gap: 0.75rem;
		}
		.row-arrow {
			display: none;
		}
	}
</style>
