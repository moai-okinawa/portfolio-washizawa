---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import ProjectTabs from '../../components/ProjectTabs.astro';
import { CLIENT_WORKS, SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`Client Work — Projects — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main id="main-content">
			<header class="page-head">
				<p class="eyebrow rise-in" style="--delay: 0.05s">Works</p>
				<h1 class="display">
					<span class="mask-line"
						><span style="--delay: 0.18s">Projects</span></span
					>
				</h1>
			</header>

			<ProjectTabs current="client" />

			<p class="note" data-reveal>
				業務として携わった案件の一覧です。守秘のため詳細は掲載していません。
			</p>

			<ol class="index-list">
				{
					CLIENT_WORKS.map((work, i) => (
						<li data-reveal style={`--reveal-delay: ${i * 0.06}s`}>
							<article class="entry">
								<div class="entry-head">
									<span class="num">{String(i + 1).padStart(2, '0')}</span>
									<span class="kind">{work.platform}</span>
								</div>
								<h2 class="entry-title">{work.title}</h2>
								<div class="entry-foot">
									<div class="tags">
										{work.tech.map((t) => (
											<span class="tag-item">{t}</span>
										))}
									</div>
									<span class="role">{work.role}</span>
								</div>
							</article>
						</li>
					))
				}
			</ol>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: var(--container-wide);
		max-width: calc(100% - 2.5em);
		margin: 0 auto;
		padding: 0 0 6rem;
	}
	.page-head .display {
		margin-top: 1.25rem;
	}

	.note {
		margin: 0 0 2rem;
		font-size: 0.85rem;
		line-height: 1.8;
		color: var(--muted-foreground);
	}

	.index-list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--border);
	}
	.index-list li {
		border-bottom: 1px solid var(--border);
	}
	.entry {
		padding: 2rem 0.25rem;
	}
	.entry-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.85rem;
	}
	.num {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--primary);
		letter-spacing: 0.1em;
	}
	.kind {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.14em;
		color: var(--primary);
		text-align: right;
	}
	.entry-title {
		margin: 0 0 1.1rem;
		font-size: clamp(1.25rem, 2.8vw, 1.75rem);
		font-weight: 700;
		letter-spacing: 0.01em;
		line-height: 1.3;
		color: var(--foreground);
	}
	.entry-foot {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem 1.5rem;
		flex-wrap: wrap;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
	}
	.tag-item {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--muted-foreground);
	}
	.tag-item::before {
		content: '#';
		color: var(--primary);
		margin-right: 0.15em;
	}
	.role {
		font-size: 0.85rem;
		color: var(--muted-foreground);
	}

	@media (max-width: 720px) {
		.entry-foot {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.75rem;
		}
	}
</style>
