---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import ProjectTabs from '../../components/ProjectTabs.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const projects = (await getCollection('projects')).sort(
	(a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf(),
);
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`Projects — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main id="main-content">
			<header class="page-head">
				<p class="eyebrow rise-in" style="--delay: 0.05s">Works</p>
				<h1 class="display">
					<span class="mask-line"
						><span style="--delay: 0.18s">Projects</span></span
					>
				</h1>
			</header>

			<ProjectTabs current="personal" />

			<ol class="index-list">
				{
					projects.map((project, i) => (
						<li data-reveal style={`--reveal-delay: ${i * 0.06}s`}>
							<article class="entry">
								<div class="entry-head">
									<span class="num">{String(i + 1).padStart(2, '0')}</span>
									<div class="entry-meta">
										<span class="kind">{project.data.status}</span>
										<span class="year">{project.data.startDate.getFullYear()}</span>
									</div>
								</div>
								<h2 class="entry-title">
									<a href={`/projects/${project.id}/`}>{project.data.title}</a>
								</h2>
								<p class="entry-desc">{project.data.description}</p>
								<div class="entry-foot">
									<div class="tags">
										{project.data.tags.map((t) => (
											<span class="tag-item">{t}</span>
										))}
									</div>
									<div class="links">
										{project.data.url && (
											<a class="link-more" href={project.data.url} target="_blank" rel="noopener">
												<span class="label">Site</span> <span class="arrow">↗</span>
												<span class="sr-only">（新しいタブで開きます）</span>
											</a>
										)}
										{project.data.repo && (
											<a class="link-more" href={project.data.repo} target="_blank" rel="noopener">
												<span class="label">Repo</span> <span class="arrow">↗</span>
												<span class="sr-only">（新しいタブで開きます）</span>
											</a>
										)}
									</div>
								</div>
							</article>
						</li>
					))
				}
			</ol>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: var(--container-wide);
		max-width: calc(100% - 2.5em);
		margin: 0 auto;
		padding: 0 0 6rem;
	}
	.page-head .display {
		margin-top: 1.25rem;
	}

	.index-list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--border);
	}
	.index-list li {
		border-bottom: 1px solid var(--border);
	}
	.entry {
		padding: 2.5rem 0.25rem;
	}
	.entry-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1rem;
	}
	.num {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--primary);
		letter-spacing: 0.1em;
	}
	.entry-meta {
		display: flex;
		align-items: baseline;
		gap: 1.25rem;
	}
	.kind {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--primary);
	}
	.year {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.12em;
		color: var(--muted-foreground);
		font-variant-numeric: tabular-nums;
	}
	.entry-title {
		margin: 0 0 0.75rem;
		font-size: clamp(1.5rem, 3.5vw, 2.25rem);
		font-weight: 700;
		letter-spacing: 0.01em;
		line-height: 1.2;
	}
	.entry-title a {
		color: var(--foreground);
		transition: color 0.2s ease;
	}
	.entry-title a:hover,
	.entry-title a:focus-visible {
		color: var(--primary);
	}
	.entry-desc {
		margin: 0 0 1.5rem;
		max-width: 46em;
		color: var(--muted-foreground);
		font-size: 0.95rem;
		line-height: 1.8;
	}
	.entry-foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		flex-wrap: wrap;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
	}
	.tag-item {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--muted-foreground);
	}
	.tag-item::before {
		content: '#';
		color: var(--primary);
		margin-right: 0.15em;
	}
	.links {
		display: flex;
		gap: 1.75rem;
	}
</style>
