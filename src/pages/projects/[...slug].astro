---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { slug: project.id },
		props: project,
	}));
}

type Props = CollectionEntry<'projects'>;

const project = Astro.props;
const { Content } = await render(project);
const { title, description, startDate, endDate, status, repo, url, tags } = project.data;
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main id="main-content">
			<article>
				<p class="back"><a href="/projects"><span aria-hidden="true">←</span> Projects</a></p>
				<p class="eyebrow">{status}</p>
				<h1>{title}</h1>
				<div class="meta">
					<span class="dates">
						<FormattedDate date={startDate} />
						{endDate && <> – <FormattedDate date={endDate} /></>}
					</span>
					{tags.map((t) => <span class="tag-item">{t}</span>)}
				</div>
				<div class="links">
					{url && (
						<a class="link-more" href={url} target="_blank" rel="noopener">
							<span class="label">Site</span> <span class="arrow">↗</span>
							<span class="sr-only">（新しいタブで開きます）</span>
						</a>
					)}
					{repo && (
						<a class="link-more" href={repo} target="_blank" rel="noopener">
							<span class="label">Repo</span> <span class="arrow">↗</span>
							<span class="sr-only">（新しいタブで開きます）</span>
						</a>
					)}
				</div>
				<hr />
				<div class="prose">
					<Content />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		padding-top: 4rem;
	}
	.back {
		margin: 0 0 2.5rem;
	}
	.back a {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--muted-foreground);
	}
	.back a:hover {
		color: var(--primary);
	}
	.eyebrow {
		margin-bottom: 1rem;
	}
	h1 {
		margin: 0 0 1.25rem;
		font-size: clamp(2rem, 5vw, 3rem);
		letter-spacing: 0.01em;
		line-height: 1.15;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
		align-items: baseline;
		margin-bottom: 1.5rem;
	}
	.dates {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		letter-spacing: 0.12em;
		color: var(--muted-foreground);
		font-variant-numeric: tabular-nums;
	}
	.tag-item {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--muted-foreground);
	}
	.tag-item::before {
		content: '#';
		color: var(--primary);
		margin-right: 0.15em;
	}
	.links {
		display: flex;
		gap: 1.75rem;
		margin-bottom: 1.5rem;
	}
	.prose {
		color: var(--foreground);
	}
	.prose :global(h2) {
		margin-top: 2rem;
	}
	.prose :global(img) {
		display: block;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		box-shadow: var(--shadow);
	}
</style>
