---
import { Image } from 'astro:assets';
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import CategoryBadge from '../components/CategoryBadge.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & { id: string; headings?: MarkdownHeading[] };

const {
	id,
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	heroImageAlt,
	category,
	headings = [],
} = Astro.props;
const ogImage = heroImage?.src ?? `/og/blog/${id}.png`;
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<html lang="ja">
	<head>
		<BaseHead title={title} description={description} image={ogImage} type="article" />
	</head>
	<body>
		<Header />
		<main id="main-content">
			<article>
				<p class="back"><a href="/blog"><span aria-hidden="true">←</span> Blog</a></p>
				{
					heroImage && (
						<div class="hero">
							<Image width={1020} height={510} src={heroImage} alt={heroImageAlt ?? ''} />
						</div>
					)
				}
				<header class="title">
					<div class="meta">
						{category && <CategoryBadge category={category} />}
						<span class="dates">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<span class="updated">
										(updated <FormattedDate date={updatedDate} />)
									</span>
								)
							}
						</span>
					</div>
					<h1>{title}</h1>
				</header>
				<div class="prose">
					<slot />
				</div>
			</article>
			{
				tocHeadings.length > 0 && (
					<aside class="toc" aria-label="目次">
						<nav>
							<p class="toc-label">On this page</p>
							<ul>
								{tocHeadings.map((h) => (
									<li class={`depth-${h.depth}`}>
										<a href={`#${h.slug}`}>{h.text}</a>
									</li>
								))}
							</ul>
						</nav>
					</aside>
				)
			}
		</main>
		<Footer />

		<script>
			// TOC scroll spy: highlight the heading currently at the top of the viewport.
			const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
			if (tocLinks.length > 0) {
				const targets = tocLinks
					.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
					.filter((el): el is HTMLElement => el !== null);
				const setActive = () => {
					const offset = 100;
					let current = targets[0];
					for (const t of targets) {
						if (t.getBoundingClientRect().top <= offset) current = t;
					}
					for (const a of tocLinks) {
						a.classList.toggle('active', decodeURIComponent(a.hash.slice(1)) === current?.id);
					}
				};
				let ticking = false;
				document.addEventListener(
					'scroll',
					() => {
						if (ticking) return;
						ticking = true;
						requestAnimationFrame(() => {
							setActive();
							ticking = false;
						});
					},
					{ passive: true },
				);
				setActive();
			}

			const blocks = document.querySelectorAll('pre.mermaid-source');
			if (blocks.length > 0) {
				const { default: mermaid } = await import('mermaid');
				const isDark = document.documentElement.classList.contains('dark');
				mermaid.initialize({
					startOnLoad: false,
					theme: isDark ? 'dark' : 'default',
					fontFamily: 'inherit',
					securityLevel: 'strict',
				});
				for (let i = 0; i < blocks.length; i++) {
					const pre = blocks[i];
					const source = (pre.textContent ?? '').trim();
					try {
						const { svg } = await mermaid.render(`mermaid-${i}`, source);
						const wrapper = document.createElement('div');
						wrapper.className = 'mermaid-diagram';
						wrapper.innerHTML = svg;
						pre.replaceWith(wrapper);
					} catch (err) {
						console.error('mermaid render failed:', err);
					}
				}
			}
		</script>
	</body>
</html>

<style>
	main {
		width: var(--container-narrow);
		max-width: calc(100% - 2em);
		margin: 0 auto;
		padding: 2.5em 1em 5em;
	}

	/* Table of contents — floats in the right gutter on wide screens */
	.toc {
		display: none;
	}
	@media (min-width: 1160px) {
		main {
			position: relative;
		}
		.toc {
			display: block;
			position: absolute;
			left: 100%;
			top: 0;
			height: 100%;
			width: 15rem;
			margin-left: 3rem;
		}
		.toc nav {
			position: sticky;
			top: 6rem;
			max-height: calc(100vh - 8rem);
			overflow-y: auto;
			overscroll-behavior: contain;
		}
	}
	.toc-label {
		margin: 0 0 0.9rem;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 500;
		letter-spacing: 0.24em;
		text-transform: uppercase;
		color: var(--muted-foreground);
	}
	.toc ul {
		list-style: none;
		margin: 0;
		padding: 0;
		border-left: 1px solid var(--border);
	}
	.toc li a {
		display: block;
		padding: 0.35rem 0 0.35rem 1rem;
		margin-left: -1px;
		border-left: 2px solid transparent;
		font-size: 0.8rem;
		line-height: 1.5;
		color: var(--muted-foreground);
		transition:
			color 0.2s ease,
			border-color 0.2s ease;
	}
	.toc li.depth-3 a {
		padding-left: 2rem;
	}
	.toc li a:hover {
		color: var(--foreground);
	}
	.toc li a.active {
		color: var(--foreground);
		font-weight: 600;
		border-left-color: var(--primary);
	}
	.back {
		margin: 0 0 2.5rem;
	}
	.back a {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--muted-foreground);
	}
	.back a:hover {
		color: var(--primary);
	}
	.hero {
		margin-bottom: 1.5rem;
	}
	.hero :global(img) {
		width: 100%;
		height: auto;
		border-radius: var(--radius);
	}
	.title {
		margin-bottom: 2rem;
	}
	.meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-bottom: 0.75rem;
	}
	.dates {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		letter-spacing: 0.12em;
		color: var(--muted-foreground);
		font-variant-numeric: tabular-nums;
	}
	.updated {
		margin-left: 0.5rem;
		font-style: italic;
	}
	.title h1 {
		margin: 0;
		font-size: 2.25rem;
		letter-spacing: -0.02em;
	}
	.prose {
		color: var(--foreground);
	}
	.prose :global(h2) {
		margin-top: 2rem;
	}
	.prose :global(h3) {
		margin-top: 1.5rem;
	}
	.prose :global(h2),
	.prose :global(h3) {
		scroll-margin-top: 5.5rem;
	}
	.prose :global(.mermaid-source) {
		font-family: var(--font-mono);
		font-size: 0.85em;
		padding: 1em 1.25em;
		border: 1px dashed var(--border);
		border-radius: var(--radius);
		background: var(--muted);
		color: var(--muted-foreground);
		overflow-x: auto;
		white-space: pre;
	}
	.prose :global(.mermaid-diagram) {
		margin: 1.75rem 0;
		display: flex;
		justify-content: center;
	}
	.prose :global(.mermaid-diagram svg) {
		max-width: 100%;
		height: auto;
	}
	.prose :global(figure) {
		margin: 1.75rem 0;
	}
	.prose :global(figure img) {
		display: block;
		width: 100%;
		height: auto;
		border-radius: var(--radius);
	}
	.prose :global(.link-card) {
		display: flex;
		align-items: stretch;
		margin: 1.75rem 0;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--card);
		color: var(--card-foreground);
		text-decoration: none;
		overflow: hidden;
		transition: border-color 0.2s ease;
	}
	.prose :global(.link-card:hover) {
		border-color: var(--primary);
	}
	.prose :global(.link-card-body) {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		flex: 1 1 auto;
		min-width: 0;
		padding: 1rem 1.25rem;
	}
	.prose :global(.link-card-title) {
		font-weight: 600;
		line-height: 1.45;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.prose :global(.link-card-description) {
		font-size: 0.85rem;
		line-height: 1.55;
		color: var(--muted-foreground);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.prose :global(.link-card-site) {
		margin-top: auto;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--muted-foreground);
	}
	.prose :global(.link-card-image) {
		flex: 0 0 auto;
		width: 30%;
		max-width: 220px;
	}
	.prose :global(.link-card-image img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	@media (max-width: 560px) {
		.prose :global(.link-card-image) {
			display: none;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.prose :global(.link-card) {
			transition: none;
		}
	}
	.prose :global(figcaption) {
		margin-top: 0.5rem;
		font-size: 0.85rem;
		color: var(--muted-foreground);
		text-align: center;
		line-height: 1.5;
	}
</style>
